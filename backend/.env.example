DATABASE_URL=postgresql://newsuser:newspass@localhost:5432/newsdb
# Dedicated DB for the pytest suite (see backend/README.md). Defaults to this when
# unset; the tests create it if missing and never touch DATABASE_URL's `newsdb`.
# TEST_DATABASE_URL=postgresql://newsuser:newspass@localhost:5432/newsdb_test
GROQ_API_KEY=your_groq_api_key_here
NEWSAPI_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Shared secret required via the X-Admin-Key header on candidate issue-tag
# write routes (see backend/app/auth.py). Unset = those routes 401 everything.
ADMIN_API_KEY=
